#!/usr/bin/env bash
# PATH stand-in for the real appimagetool. flutter_distributor invokes
# `appimagetool` with no update-information flag; this inserts one when
# update_information (or FILE_TILE_UPDATE_INFORMATION) has a value, then
# execs the next appimagetool on PATH.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
real=""
IFS=':' read -ra path_dirs <<< "${PATH:-}"
for dir in "${path_dirs[@]}"; do
  [[ -n "$dir" ]] || continue
  candidate="$dir/appimagetool"
  [[ -x "$candidate" ]] || continue
  resolved="$(readlink -f "$candidate")"
  if [[ "$resolved" != "$self" ]]; then
    real="$candidate"
    break
  fi
done

if [[ -z "$real" ]]; then
  echo "appimagetool: real appimagetool not found on PATH" >&2
  exit 127
fi

info="${FILE_TILE_UPDATE_INFORMATION:-}"
if [[ -z "$info" ]]; then
  info_file="${FILE_TILE_UPDATE_INFORMATION_FILE:-$(dirname "$self")/../update_information}"
  if [[ -f "$info_file" ]]; then
    info="$(sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$info_file" | head -n 1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  fi
fi

args=()
if [[ -n "$info" ]]; then
  has_flag=0
  for arg in "$@"; do
    if [[ "$arg" == "--updateinformation" || "$arg" == "-u" ]]; then
      has_flag=1
      break
    fi
  done
  if [[ "$has_flag" -eq 0 ]]; then
    args+=(--updateinformation "$info")
  fi
fi
args+=("$@")

"$real" "${args[@]}"
status=$?

# appimagetool writes the .zsync in the working directory. Keep it beside the AppImage.
dest=""
for arg in "$@"; do
  if [[ "$arg" == *.AppImage ]]; then
    dest="$arg"
  fi
done
if [[ -n "$dest" ]]; then
  dropped="$(basename "$dest").zsync"
  if [[ -f "$dropped" ]]; then
    mkdir -p "$(dirname "$dest")"
    mv -f "$dropped" "$dest.zsync"
  fi
fi

exit "$status"
